{
  "skill_name": "okx-ai",
  "evals": [
    {
      "id": 1,
      "prompt": "查看 Agent #42 的评价和评分。",
      "expected_output": "查询 Agent #42 的信誉，并展示返回的平均评分、评价总数和评价内容，不得改写数值。",
      "files": ["evals/fixtures/reputation-page-1.json"],
      "expectations": [
        "Calls `onchainos agent feedback-list --agent-id 42` exactly once.",
        "Does not call a write command.",
        "Reports the returned average rating, total review count, and review data."
      ],
      "assertions": {
        "required_commands": ["onchainos agent feedback-list --agent-id 42"],
        "forbidden_commands": [
          "onchainos agent activate",
          "onchainos agent deactivate",
          "onchainos agent feedback ",
          "onchainos agent register",
          "onchainos agent update"
        ],
        "response_includes": ["4.80", "5.00", "4.60"]
      }
    },
    {
      "id": 2,
      "prompt": "Market Maker 这个 Agent 的信誉怎么样？",
      "expected_output": "要求用户提供 Agent ID，而不是根据 Agent 名称推断 ID。",
      "files": [],
      "expectations": [
        "Does not invoke `onchainos`.",
        "Does not guess or fabricate an Agent ID.",
        "Asks the user to provide or select an Agent ID."
      ],
      "assertions": {
        "forbidden_commands": ["onchainos "],
        "response_includes": ["ID"],
        "response_excludes": ["#42"]
      }
    },
    {
      "id": 3,
      "prompt": "发布 Agent #42 到市场。",
      "expected_output": "使用用户的中文语言偏好发布 Agent #42，并说明该上架申请已提交审核。",
      "files": ["evals/fixtures/listing-submitted.json"],
      "expectations": [
        "Calls `onchainos agent activate --agent-id 42 --preferred-language zh-CN` exactly once.",
        "Does not make a follow-up read.",
        "States that the listing was submitted for review."
      ],
      "assertions": {
        "required_commands": ["onchainos agent activate --agent-id 42 --preferred-language zh-CN"],
        "forbidden_commands": [
          "onchainos agent detail",
          "onchainos agent my-agents",
          "onchainos agent search"
        ],
        "response_includes": ["审核"]
      }
    },
    {
      "id": 4,
      "prompt": "查看我的订阅。",
      "expected_output": "只读查询订阅列表，按 Active 和 Ended 展示规范字段、动态设备接收状态、无接收设备提醒，并从 nextAction.actionLabel 渲染后续选项。",
      "files": ["evals/fixtures/subscription-list.json"],
      "expectations": [
        "Calls `onchainos agent subscription-list --page-size 10` exactly once.",
        "Renders both active and ended subscriptions from the returned page.",
        "Warns only for the explicit empty device list and renders each returned `nextAction.actionLabel` in order without executing it."
      ],
      "assertions": {
        "required_commands": ["onchainos agent subscription-list --page-size 10"],
        "forbidden_commands": [
          "onchainos agent subscribe-detail",
          "onchainos agent subscribe-device-update",
          "onchainos agent subscribe-cancel",
          "okx-a2a user watch"
        ],
        "response_includes": [
          "Alpha Signal",
          "Old Signal",
          "2026-09-16 18:10 UTC",
          "试用期",
          "MacBook Pro",
          "iPhone",
          "No Receiver Signal",
          "1. 调整接收设备",
          "2. 查看订阅详情",
          "3. 取消订阅",
          "4. 查看下一页"
        ],
        "response_excludes": [
          "开始监听",
          "推荐",
          "allowedJobIds",
          "next_subscription_page"
        ]
      }
    }
  ]
}
